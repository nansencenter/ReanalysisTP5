
Mdir=/cluster/home/xiejp/REANALYSIS_TP5_spinup/ReanalysisTP5/FILES

ln -sf ${Mdir}/blkdat.input
ln -sf ${Mdir}/regional.* .
ln -sf ${Mdir}/grid.info .
ln -sf ${Mdir}/depths*.uf .
ln -sf ${Mdir}/newpos.uf .

# linking the performed program and infile
Idir=/cluster/home/xiejp/REANALYSIS_TP5_spinup/ReanalysisTP5/preobs_scripts/Infile/

check_prg=${Idir}/check_ncfile.py

if [ ! -s ./prep_obs_profile ]; then
  ln -sf /cluster/home/xiejp/enkf/EnKF-MPI-TOPAZ/Prep_Fram/prep_obs prep_obs_profile 
fi

Odir_dt=/cluster/work/users/xiejp/DATA/data0/profile
Odir_dt2=/cluster/work/users/xiejp/DATA/data0/profile/Arc
Odir_nrt=/cluster/work/users/xiejp/ARC_MFC/downobs_nrt
Outdir=/cluster/work/users/xiejp/work_2024/Data_TP5/TSprofile


if [ ! -s ${Outdir} ]; then
  mkdir ${Outdir}
fi
for ity in SAL TEM ; do
  if [ ! -s ${Outdir}/${ity} ]; then
    mkdir ${Outdir}/${ity}
  fi
done

Tblist=0         # output the profile sources

Tmix=1          # try to find the combined profiles

ulimit -s 2000000

Jdy0=Jdate1
Jdy1=Jdate2

for Jdy in `seq ${Jdy0} ${Jdy1}`; do
  Fobs=${Outdir}/TEM/obs_TEM_${Jdy}.nc
  echo ${Fobs}
  if [ ! -s ${Fobs} -o ! -s ${Outdir}/SAL/obs_SAL_${Jdy}.nc ]; then
    rm P*.nc T*.nc infile.data0 infiles.txt
    i0=0
    for idy in `seq 0 6`; do
      let Ndy=Jdy-idy
      if [ ${Tmix} -eq 1 ]; then
        Ndate=$(jultodate ${Ndy} 1950 1 1);
        # divided into two branchs:
        # firtly check the delayed model profiles:
        Fnam=${Odir_dt}/${Ndate:0:4}/CO_DMQCGL01_${Ndate}_*.nc
        aa=`ls ${Fnam} | sed -n '$='`
        if [[ ${aa} -gt 0 ]]; then
           for ifile in $(ls ${Fnam}); do
              jj=$(python ${check_prg} ${ifile} 2>&1) 
              if [ $jj -eq 1 ]; then
                 jfile=${ifile#${Odir_dt}/${Ndate:0:4}/CO_DMQCGL01_${Ndate}_}
                 Fnew=${jfile:0:1}`echo 00${i0}|tail -4c`.nc
                 ln -sf ${ifile} ${Fnew} 
                 let i0=i0+1
                 if [ ${i0} -eq 1 ]; then
                    Sline=${Fnew}
                 else
                    Sline=$(echo ${Sline} ${Fnew})
                 fi
              fi
           done
        fi
        # extending by nrt profiles 
        #Fnam2=${Odir_nrt}/nrt_${Ndate:0:4}/CO_NRT_${Ndate}_*.nc
        Fnam2=${Odir_dt2}/${Ndate:0:4}/CO_DMQCGL01_${Ndate}_*.nc
        bb=`ls ${Fnam2} | sed -n '$='`
        if [[ ${bb} -gt 0 ]]; then
           for ifile in $(ls ${Fnam2}); do
              jj=$(python ${check_prg} ${ifile} 2>&1) 
              if [ $jj -eq 1 ]; then
                 #jfile=${ifile#${Odir_nrt}/nrt_${Ndate:0:4}/CO_NRT_${Ndate}_}
                 jfile=${ifile#${Odir_dt2}/${Ndate:0:4}/CO_DMQCGL01_${Ndate}_}
                 Fnew2=${jfile:0:1}`echo 00${i0}|tail -4c`.nc
                 ln -sf ${ifile} ${Fnew2} 
                 let i0=i0+1
                 if [ ${i0} -eq 1 ]; then
                    Sline=${Fnew2}
                 else
                    Sline=$(echo ${Sline} ${Fnew2})
                 fi
              fi
           done
        fi
      fi
    done
    echo "i0=" $i0
    # preprare the infile.data0 saved as toto
    if [ ${i0} -gt 0 ]; then
       echo ${Jdy}
       echo ${Sline}
       sed "s/JDATE_coriolis.nc/${Sline}/" ${Idir}/infile.data_coriolis > infile.data0

       # deal with SAL and TEM respectively 
       for otype in SAL TEM ; do
          if [ ! -s ${Outdir}/${otype}/obs_${otype}_${Jdy}.nc ]; then
             if [ ${otype}x = "SAL"x ]; then
                var=0.02
             elif [ ${otype}x = "TEM"x ]; then
                var=0.5
             fi
             sed "s/OTY/${otype}/" infile.data0 | sed "s/OVAR/${var}/" > infile.data 

             ./prep_obs_profile
             if [ -s observations-${otype}.nc -a observations.uf ]; then
                mv observations-${otype}.nc ${Outdir}/${otype}/obs_${otype}_${Jdy}.nc
                mv observations.uf ${Outdir}/${otype}/obs_${otype}_${Jdy}.uf
             fi 
             if [ ${Tblist} -eq 1 ]; then
                for bfile in Blacklist_Prof_QC observations_info AfterQC-${otype} ; do
                   if [ -s ${bfile}.nc ]; then
                      mv ${bfile}.nc ${Outdir}/${otype}/${bfile}-${Jdy}.nc  
                   elif [ -s ${bfile}.uf ]; then
                      mv ${bfile}.uf ${Outdir}/${otype}/${bfile}-${Jdy}.uf  
                   elif [ -s ${bfile}.txt ]; then
                      mv ${bfile}.txt ${Outdir}/${otype}/${bfile}-${Jdy}.txt  
                   fi
                done
             fi
          fi
       done
    fi
    rm T*.nc P*.nc
  fi
done
