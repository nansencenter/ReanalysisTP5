#!/bin/bash -l
#
# Project:
#SBATCH --account=nn2993k --qos=preproc
#
# Job name:
#SBATCH -J "SIC_post"
#
#SBATCH -N 1 
##SBATCH --exclusive
#SBATCH --ntasks=100 --cpus-per-task=1
#SBATCH --mem-per-cpu=3G
#
# Wall clock limit:
#SBATCH -t 01:00:00
#
#SBATCH -o en_post.out
#SBATCH -e en_post.err
##SBATCH -m jiping.xie@nersc.no

# set up job environment
set -e # exit on error
set -u # exit on unset variables
#set -x

BINDIR=EXVAR0
ANALYSISDIR=EXVAR1
ENSSIZE=EXVAR2
NPROC=EXVAR3
JULDAY=EXVAR4

Modday=EXVAR_1
RESULTSDIR=EXVAR_2

ml load NCO/5.1.9-iomkl-2022a
cd "${ANALYSISDIR}"

# whether assimilating hice or not
Fhice=observations.uf.HICE
echo ${Fhice}
if [ $(wc -l < "${Fhice}") -eq 0 ]; then
   echo 'no '${Fhice}
   Hflag=0
   [ -s ${BINDIR}/../hice.log ] && rm ${BINDIR}/../hice.log
else
   echo 'find ' ${Fhice}
   echo ${BINDIR}/../hice.log
   # SIT observation impact which can be tuned like 0.5 for the first time assimilation in Autumn.
   if [ ! -s ${BINDIR}/../hice.log ]; then
      Hflag=0.5
      Ihice=1
   else
      Hflag=1.0
      Ihice=$(cat ${BINDIR}/../hice.log)
      if [ ${Ihice} -lt 2 ]; then
         Hflag=0.8
      fi 
      (( Ihice = Ihice + 1 ))
   fi
   echo ${Ihice} > ${BINDIR}/../hice.log
fi

istep=0
if [ ${istep} -eq 0 ]; then
   Nbin=100
   (( NN = ($ENSSIZE - 1 ) / $Nbin + 1 ))
   for icycl in `seq 1 ${NN}`; do
      for ipre in `seq 1 ${Nbin}`; do
         (( imem = $ipre + ( $icycl - 1 ) * $Nbin ))
         if [ $imem -le ${ENSSIZE} ]; then
            mem=`printf "%03d\n" $imem`
            # fix hycom
            #
            if [ ! -f "analysis${mem}.a" ]
            then
               echo "ERROR: EnKF_assemble.sh failed for member ${mem}"
               exit 1;
            else
               echo "fixhycom analysis${mem}.a ${imem} forecast${mem}.nc ice_forecast${mem}.nc ${Modday} ${Hflag}"
               ${BINDIR}/fixhycom analysis${mem}.a ${imem} forecast${mem}.nc ice_forecast${mem}.nc ${Modday} ${Hflag} &
               if [ $? -ne 0 ]; then
                  echo "ERROR: fixhycom failed for member ${imem}"
                  exit 1;
               fi
            fi
         fi
      done
      wait
      sleep 1
   done
   istep=1
fi


# double check all the member files are ready
istep=1
while [ $istep -gt 0 ]; do
   ${BINDIR}/Checkmem.sh ${ENSSIZE} fixanalysis .a
   Ftemp=Checkmem_fixanalysis_0.log
   if [ -s ${Ftemp} ]; then
      tmpsize=$(stat -c%s ${Ftemp})
      if [ "$tmpsize" -gt 1 ]; then
         Fnams=$(cat ${Ftemp})
         for inam in ${Fnams} ; do
            ${BINDIR}/fixhycom analysis${inam}.a ${inam} forecast${inam}.nc ice_forecast${inam}.nc ${Modday} ${Hflag} &
         done
         wait
         sleep 1
         ${BINDIR}/Checkmem.sh ${ENSSIZE} fixanalysis .a
         [ ! -s ${Ftemp} ] && istep=-1
      else
         istep=-1
      fi
   else
      istep=-1
   fi
done
echo "fixhycom was done for all memmbers!"

#
(( NN = ($ENSSIZE - 1 ) / $Nbin + 1 ))
for icycl in `seq 1 ${NN}`; do
   for ipre in `seq 1 ${Nbin}`; do
      (( imem = $ipre + ( $icycl - 1 ) * $Nbin ))
      if [ $imem -le ${ENSSIZE} ]; then
         mem=`printf "%03d\n" $imem`
         if [ ! -f "fixanalysis${mem}.a" ]
         then
            echo "ERROR: fixhycom failed for member ${mem}"
            exit 1;
         else
            if [ -s tmp${mem}.b ]; then
               sed -i '3,$d' tmp${mem}.b
               cat fixanalysis${mem}.b >> tmp${mem}.b
               mv tmp${mem}.b fixanalysis${mem}.b
            fi
            # echo "echo ${BINDIR}/restart2nc fixanalysis${mem}.a  fix_ice_forecast${mem}.nc "
            ${BINDIR}/restart2nc fixanalysis${mem}.a fix_ice_forecast${mem}.nc &
            if [ $? -ne 0 ]; then
               echo "ERROR: restart2nc for member ${mem} after fixhycom"
               exit 1;
            fi
         fi
      fi
   done
   wait
   sleep 1
done
wait
sleep 1

# double check all the member files are ready
istep=1
while [ $istep -gt 0 ]; do
   ${BINDIR}/Checkmem.sh ${ENSSIZE} fixanalysis .nc
   Ftemp=Checkmem_fixanalysis_0.log
   if [ -s ${Ftemp} ]; then
      tmpsize=$(stat -c%s ${Ftemp})
      if [ "$tmpsize" -gt 1 ]; then
         Fnams=$(cat ${Ftemp})
         for inam in ${Fnams} ; do
            ${BINDIR}/restart2nc fixanalysis${inam}.a fix_ice_forecast${inam}.nc &
         done
         wait
         sleep 1
         ${BINDIR}/Checkmem.sh ${ENSSIZE} fixanalysis .nc
         [ ! -s ${Ftemp} ] && istep=-1
      else
         istep=-1
      fi
   else
      istep=-1
   fi
done
echo "fixanalysis???.nc done!"

# calculating the mean states after reanalsysis
if [ -s icep_analysis001.nc ]; then
   MeanNcs="icep_forecast icep_analysis fixanalysis fix_ice_forecast"
   Meanicep=1
else
   MeanNcs="fixanalysis fix_ice_forecast"
   Meanicep=0
fi
for ifile in ${MeanNcs} ; do
   if [ ! -s ${ifile}.nc ]; then 
      ncea ${ifile}???.nc ${ifile}.nc &
   fi
done
wait
sleep 1

if [ -s fixanalysis.nc ]; then
   mv fixanalysis001.nc ${RESULTSDIR}/${JULDAY}/ANALYSIS/analysis001.nc 
   mv fixanalysis.nc ${RESULTSDIR}/${JULDAY}/ANALYSIS/analysis.nc 
   [ -s bfix_forecast001.nc ] && mv bfix_forecast001.nc ${RESULTSDIR}/${JULDAY}/ANALYSIS/.
fi
if [ -s fix_ice_forecast.nc ]; then
   cp fix_ice_forecast001.nc ${RESULTSDIR}/${JULDAY}/ANALYSIS/ice_analysis001.nc 
   mv fix_ice_forecast.nc ${RESULTSDIR}/${JULDAY}/ANALYSIS/ice_analysis.nc 
fi
if [ ${Meanicep} -eq 1 ]; then
   if [ -s icep_analysis.nc ]; then
      cp icep_analysis001.nc ${RESULTSDIR}/${JULDAY}/ANALYSIS/.
      mv icep_analysis.nc ${RESULTSDIR}/${JULDAY}/ANALYSIS/.
   fi
   if [ -s icep_forecast.nc ]; then
      cp icep_forecast001.nc ${RESULTSDIR}/${JULDAY}/FORECAST/.
      mv icep_forecast.nc ${RESULTSDIR}/${JULDAY}/FORECAST/.
   fi

   echo "saving the analyzed icep for next forecast" 
   . ${BINDIR}/../assimilation_specs.sh
   export PPERT FORECASTDIR
   echo " PPERT FORECASTDIR: ${PPERT} ${FORECASTDIR}"
   if [ ${PPERT} -eq 2 ]; then
      Sdate=$(jultodate ${JULDAY} 1950 1 1)
      Strdate=${Sdate:0:4}-${Sdate:4:2}-${Sdate:6:2}
      for e in `seq 1 ${ENSSIZE}`; do
         cmem=`echo 00${e}|tail -4c`
         Ficep=icep_analysis${cmem}.nc
         Fnew=icep.${Strdate}_mem${cmem}.nc
         [ -s ${Ficep} ] && { mv ${Ficep} ${FORECASTDIR}/cice/${Fnew}; [ $e -eq 1 ] && echo "mv icep for ${cmem}"; } 
      done
   fi

fi

echo "FINISHED (postprocess)" 
